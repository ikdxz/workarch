;; Components

(include "./src/components/bar/components/left-bar.yuck")
(include "./src/components/bar/components/workspaces.yuck")
(include "./src/components/bar/components/right-bar.yuck")



(defwidget top-bar []
  (box :class "top-bar"
    :orientation "h"
    :space-evenly true
    (left-bar)
    (workspaces)
    (right-bar)
  )
)

(defwindow bar :hexpand false :vexpand false
  :geometry (geometry :x "0%"
    :y "0px"
    :width "100%"
    :height "15px"
  :anchor "top center")
  :layer top
  :stacking "fg"
  :windowtype "dock"
  :exclusive false
  :monitor 0
  :focusable false
  :wm-ignore true
  (top-bar)
)
