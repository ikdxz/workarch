;; Variables

;; Music Info

(deflisten cover "scripts/music/musicCover")
(deflisten titleInfo "scripts/music/musicTitle")
(deflisten artistInfo "scripts/music/musicArtist")
(deflisten playerImage "scripts/music/playerImage")
(deflisten position "scripts/music/songPosition")
(deflisten duration "scripts/music/songDuration")



;;(defpoll brightness :interval "1s" "scripts/brightness")
(deflisten network "scripts/network")
(defpoll volume :interval "2s" "scripts/volume")

(defvar icons "assets/icons/control-center/")


;; Control Panel

(defwidget control_center []
  (box
    :orientation "v"
    :class "panel"
    :valign "start"
    (eventbox :onhoverlost "eww -c $HOME/.config/eww open --toggle control_center"
      (box :orientation "v" :valign "start" :vexpand "false"  :space-evenly "true"
        (box
          :orientation "h"
          :class "first"
          :vexpand "false"
          (box
            :orientation "v"
            :class "firstI"
            :hexpand "false"
            :vexpand "false"
            :spacing 20
            (eventbox :cursor "hand2"
              (box
                :class "burbuja"
                :orientation "horizontal"
                :halign "fill"
                :space-evenly "false"
                :vexpand "false"
                (box
                  :valign "center"
                  :halign "start"
                  :vexpand "false"
                  (image
                    :class "active"
                    :path "${icons}/wifi.svg"
                  :image-width "25")
                )
                (box
                  :orientation "v"
                  :halign "start"
                  :valign "center"
                  :class "txt"
                  (label :class "cfgTitle" :halign "start" :text "Wi-Fi")
                  (label :class "cfgTxt" :halign "start" :text network)
                )
              )
            )
            
            (box
              :class ""
              :orientation "horizontal"
              :halign "center"
              :space-evenly "false"
              :spacing "20"
              (eventbox
                :cursor "hand2"
                :class "activexll"
                :width 50
                :height 50
                (button
                  :onclick "eww -c $HOME/.config/eww open --toggle control_center && blueman-manager &"
                  :valign "center"
                  :halign "start"
                  (image :class "activexl" :path "${icons}/bluetooth.svg" :image-width "64")
                )
              )
              (eventbox
                :cursor "hand2"
                (box
                  :valign "center"
                  :halign "start"
                  (button :onclick "eww -c $HOME/.config/eww open --toggle control_center && localsend &"
                    (image :class "activexl" :path "${icons}/airdrop.svg" :image-width "64")
                  )
                )
              )
            )
            (eventbox :cursor "hand2"
              (box
                :class "burbuja"
                :orientation "horizontal"
                :halign "fill"
                :space-evenly "false"
                :vexpand "false"
                (box
                  :valign "center"
                  :halign "start"
                  :vexpand "false"
                  (image :class "active" :path "${icons}/moon.svg" :image-width "28")
                )
                (box
                  :orientation "v"
                  :halign "start"
                  :valign "center"
                  :class "txt"
                  (label :class "cfgTitle" :halign "start" :text "Focus")
                )
              )
            )
            
          )
          
          (box :orientation "v" :class "fisrtD" :hexpand "false" :space-evenly "false" :spacing 20
            (box
              :class "music"
              :valign "fill"
              :space-evenly "false"
              :orientation "v"
              (image :class "musicCovert" :halign "start" :valign "center" :path cover :image-width "70")
              (eventbox :cursor "hand2"
                (scale
                  :class "music-scale"
                  :width 10
                  :hexpand "true"
                  :value position
                  :max duration
                  :min 0
                :onchange "playerctl position {}")
              )
              (box :hexpand "false" :orientation "v"
                (label :truncate true :halign "start" :class "musicTitle" :wrap "true" :text titleInfo)
                (label :halign "start" :class "musicArtist" :wrap "true" :text artistInfo)
              )
              
              (box :class "media" :halign "center" :valign "center" :spacing 18
                
                (eventbox
                  :cursor "hand2"
                  (button
                    :class "icon-button"
                    :onclick "playerctl previous"
                    (image :class "media-control" :path "${icons}/previous.svg" :image-width 23)
                  )
                )
                
                (eventbox :cursor "hand2"
                  (button :class "icon-button" :onclick "playerctl play-pause"
                    (image :path playerImage :image-width 35)
                  )
                )
                (eventbox :cursor "hand2"
                  (button :class "icon-button" :onclick "playerctl next"
                    (image :class "media-control" :path "${icons}/next.svg" :image-width 23)
                  )
                )
                
              )
            )
            (box :orientation "h" :spacing 20
              (eventbox :cursor "hand2"
                (box
                  :orientation "v"
                  :class "inactivexl"
                  :vexpand "true"
                  :valign "center"
                  :height 10
                  :width 5
                  (button
                    :onclick 'eww -c $HOME/.config/eww open --toggle control_center && grim -g "$(slurp)" - | wl-copy'
                    (image :valign "end"  :path "${icons}/screenshot.svg" :image-width "56")
                  )
                )
              )
              (eventbox :cursor "hand2"
                (box :orientation "v" :class "inactivexl" :valign "center"
                  (image :valign "end" :path "${icons}/cast.svg" :image-width "56")
                )
              )
              
            )
          )
        )
        
        (box :class "second" :space-evenly "false" :orientation "v" :spacing 20 :valign "start" :hexpand "false" :vexpand "false"
          (box :class "cfg" :orientation "v"
            (label :class "title" :halign "start" :text "Display")
            (box
              :orientation "h"
              :space-evenly "false"
              :spacing 10
              (image :halign "end" :path "${icons}/sun-low.svg" :image-width "22")
              (scale :class "scale" :hexpand "true" :value 100 :max 100 :min 0 :onchange "xrandr --output DP-1 --gamma 1.05:0.95:0.85 --brightness $(echo \"{} / 100\" | bc -l)")
              (image :halign "end" :path "${icons}/sun-high.svg" :image-width "22")
            )
          )
          
          (box :class "cfg" :orientation "v"
            (label :class "title" :halign "start" :text "Sound")
            (box
              :orientation "h"
              :space-evenly "false"
              :spacing 10
              (box
                :orientation "h"
                :space-evenly "false"
                :spacing 10
                :hexpand "true"
                (button :class "icon-button" :onclick "pactl set-sink-volume @DEFAULT_SINK@ 0%"
                  (image :path "${icons}/audio-volume-muted.svg" :image-width 28 :image-height 28)
                )
                
                (scale :class "scale" :hexpand "true" :value volume :max 100 :min 0 :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%")
                (image :halign "start" :path "${icons}/audio-volume-high.svg" :image-width "28")
              )
              (image :class "img1" :vexpand "false" :halign "center" :valign "center" :path "${icons}/airdropm.svg" :image-width "20")
            )
          )
        )
        (box :class "third" :space-evenly "false" :orientation "v" :valign "start" :vexpand "false"
        )
      )
    )
    
  )
)



(defwindow control_center :hexpand false :vexpand false
  :geometry (geometry :x "0px"
    :y "35px"
    :width "450px"
    :height "450px"
  :anchor "top right")
  :monitor 0
  :decorated false
  :wm-ignore false
  (control_center)
)
