;; Widgets

(include "./bar/widgets/control-center.yuck")


;; Variables

(deflisten time_data :initial "{\"bar\":\"00:00 AM\", \"clock\":\"00:00\", \"date_full\":\"...\", \"date_bar\":\"...\"}"
  "scripts/time")


(defvar prueba false)


;; Bar

(defwidget right-bar []
  (box :class "date-bar"
    :orientation "h"
    :space-evenly "false"
    :halign "end"
    :valign "center"
    (button :valign "center" :width 50 :class "icons" :onclick "" :tooltip "WiFi" "")
    (button :width 10 :class "icons bluetooth" :onclick "blueman-manager &" :tooltip "Bluetooth" "󰂯")
    (button :width 10 :class "icons" :onclick "rofi -show drun -theme ~/.local/share/rofi/themes/spotlight.rasi &" "")
    (button :width 10 :class "iconos" :onclick "eww -c $HOME/.config/eww open --toggle control_center && eww update prueba=true"
        (box :spacing "-5" :class {prueba == true ? "hola icons" : "adios icons"} :valign "center" :halign "center"
          (image :path "/home/kelly/Downloads/Brave/toggle.svg" :image-width 18)
          (label :class "noti-dot" :text "")
        )
    )
    
    (label :class "date-right-bar" :text "${time_data.bar}")
    (button :class "date-right-bar" :onclick "notion-calendar-electron &" "${time_data.date_bar}")
  )
)