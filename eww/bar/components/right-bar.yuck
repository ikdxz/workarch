;; Widgets

(include "./bar/widgets/control-center.yuck")


;; Variables

(defpoll date-bar :interval "5s" "date +'%d %b %Y' | tr -d '.'")
(defpoll time :interval "60s" "date +'%H:%M' | awk -F: '{h=$1%12; if(h==0) h=12; printf \"%02d:%s %s\", h, $2, ($1<12?\"AM\":\"PM\")}'")


(defvar prueba false)


;; Bar

(defwidget right-bar []
  (box :class "date-bar"
    :orientation "h"
    :space-evenly "false"
    :halign "end"
    :valign "center"
    (eventbox :cursor "hand2" 
      (button :class "iconos" :onclick "" :tooltip "WiFi" "")
    )
    
    (eventbox :cursor "hand2"
      (button :class "bluetooth" :onclick "blueman-manager &" :tooltip "Bluetooth" "󰂯")
    )

    (eventbox :cursor "hand2"
      (button :class "iconos" :onclick "rofi -show drun -theme ~/.local/share/rofi/themes/spotlight.rasi &" "")
    )

    (eventbox :cursor "hand2"
      (button :class "iconos" :onclick "eww -c $HOME/.config/eww open --toggle control_center && eww update prueba=true"
        (box :spacing "-5" :class {prueba == true ? "hola" : "adios"} :valign "center" :halign "center"
          (image :path "/home/kelly/Downloads/Brave/toggle.svg" :image-width 18)
          (label :class "noti-dot" :text "")
        )
      )
    )
    
    (label :class "date-right-bar" :text time)
    (eventbox :cursor "hand2"
      (button :class "date-right-bar" :onclick "notion-calendar-electron &" date-bar)
    )
  )
)